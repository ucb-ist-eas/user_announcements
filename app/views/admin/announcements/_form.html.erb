<div class="row">
  <%= form_for [:admin, @announcement], html: {class: "announcement-detail col-md-6"} do |f| %>
    <%= _ua_active_model_errors(f.object) %>

    <p class="checkbox">
      <label>
        <%= f.check_box :active %>Active
      </label>
    </p>

    <p class="form-group">
      <%= f.label :message %>
      <%= f.text_area :message, size: "60x10", class: "form-control" %>
    </p>

    <p class="form-group">
      <%= f.label :starts_at %>
      <%= f.datetime_local_field :starts_at, class: "form-control" %>
    </p>

    <p class="form-group">
      <%= f.label :ends_at %>
      <%= f.datetime_local_field :ends_at, class: "form-control" %>
    </p>

    <%# ua_datetime_p(f, :starts_at) %>

    <%# ua_datetime_p(f, :ends_at) %>

    <p class="form-group">
      <%= ua_roles_html(f) %>
    </p>

    <p class="form-group">
      <%= ua_style_html(f) %>
    </p>

    <div class="form-actions">
      <%= f.submit "Save", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_announcements_path  %>
    </div>

  <% end %>

  <%- if ua_bootstrap_datetime_picker? %>
  <script>

    $(function() {
      $('.ua-datetimepicker').datetimepicker({
      });
    })
  </script>
  <% end %>
</div>
